{
  "uid": "pulse-stream",
  "title": "Pulse - Streaming Health",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "pulse"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Input rate (rows/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulse_input_rows_per_second",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Processing rate (rows/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulse_processed_rows_per_second",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka offsets behind latest",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulse_kafka_offsets_behind_latest",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Micro-batch duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulse_batch_duration_seconds",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Late events dropped by watermark (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (query) (rate(pulse_rows_dropped_by_watermark_total[5m])) * 60",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rows in streaming state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulse_state_rows",
          "legendFormat": "{{query}}"
        }
      ]
    }
  ]
}